          "name": "Events - CRUD",
          "item": [
            {
              "name": "Create a new event",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const jsonData = pm.response.json();",
                      "const data = jsonData.data;",
                      "const eventID = jsonData.data.id;",
                      "const userID = pm.environment.get(\"userID\");",
                      "const eventTitle = pm.collectionVariables.get(\"dd_eventTitle\");",
                      "const eventDescription = pm.collectionVariables.get(\"dd_eventDescription\");",
                      "const eventCategory = pm.collectionVariables.get(\"dd_eventCategory\");",
                      "const eventVenue = pm.collectionVariables.get(\"dd_eventVenue\");",
                      "const eventCity = pm.collectionVariables.get(\"dd_eventCity\");",
                      "const eventDate = pm.collectionVariables.get(\"dd_eventDate\");",
                      "const eventPrice = Number(pm.collectionVariables.get(\"dd_eventPrice\"));",
                      "const eventTotalSeats = Number(pm.collectionVariables.get(\"dd_eventTotalSeats\"));",
                      "",
                      "pm.test(\"Response status code should be 201\", () => {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test(\"success should be true\", () => {",
                      "    pm.expect(jsonData.success).to.exist.and.to.equal(true);",
                      "});",
                      "",
                      "pm.test(\"The 'id' property exists and value is '\" + eventID + \"'\", () => {",
                      "    pm.expect(jsonData.data.id).to.exist.and.to.equal(eventID);",
                      "});",
                      "",
                      "pm.test(\"Set Event ID as 'eventID' variable\", () => {",
                      "    pm.collectionVariables.set(\"dd_eventID\", eventID);",
                      "    pm.expect(pm.collectionVariables.get(\"dd_eventID\")).to.equal(eventID);",
                      "});",
                      "",
                      "pm.test(\"Validate event data properties\", () => {",
                      "    pm.expect(data.id).to.equal(eventID);",
                      "    pm.expect(data.title).to.equal(eventTitle);",
                      "    pm.expect(data.description).to.equal(eventDescription);",
                      "    pm.expect(data.category).to.equal(eventCategory);",
                      "    pm.expect(data.venue).to.equal(eventVenue);",
                      "    pm.expect(data.city).to.equal(eventCity);",
                      "    pm.expect(data.eventDate).to.equal(eventDate);",
                      "    pm.expect(Number(data.price)).to.equal(eventPrice);",
                      "    pm.expect(data.totalSeats).to.equal(eventTotalSeats);",
                      "    pm.expect(data.availableSeats).to.equal(eventTotalSeats);",
                      "    pm.expect(data.imageUrl).to.equal(\"https://example.com/banner.jpg\");",
                      "    pm.expect(data.isStatic).to.equal(false);",
                      "    pm.expect(data.userId).to.equal(Number(userID));",
                      "    pm.expect(data.createdAt).to.be.a(\"string\").and.not.empty;",
                      "    pm.expect(data.updatedAt).to.be.a(\"string\").and.not.empty;",
                      "});",
                      "",
                      "//pm.collectionVariables.set(\"dd_eventAvailableSeats\", data.availableSeats);",
                      "",
                      "pm.test(\"message should be 'Event created successfully'\", () => {",
                      "    pm.expect(jsonData.message).to.exist.and.to.equal(\"Event created successfully\");",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const description = pm.iterationData.get(\"description\");",
                      "const category = pm.iterationData.get(\"category\");",
                      "const venue = pm.iterationData.get(\"venue\");",
                      "const city = pm.iterationData.get(\"city\");",
                      "const price = Number(pm.iterationData.get(\"price\"));",
                      "const totalSeats = Number(pm.iterationData.get(\"totalSeats\"));",
                      "",
                      "// Validate CSV data",
                      "pm.test(\"Pre-request: Validate eventData.csv data\", () => {",
                      "    pm.expect(description, \"description\").to.be.a(\"string\").and.not.empty;",
                      "    pm.expect(category, \"category\").to.be.a(\"string\").and.not.empty;",
                      "    pm.expect(venue, \"venue\").to.be.a(\"string\").and.not.empty;",
                      "    pm.expect(city, \"city\").to.be.a(\"string\").and.not.empty;",
                      "    pm.expect(Number(price), \"price\").to.be.a(\"number\");",
                      "    pm.expect(Number(totalSeats), \"totalSeats\").to.be.a(\"number\");",
                      "});",
                      "",
                      "// Generate unique event title",
                      "pm.test(\"Pre-request: Generate event title and set as collection variable\", () => {",
                      "    const d = new Date();",
                      "    const p = n => String(n).padStart(2, \"0\");",
                      "    const ts = `${d.getUTCFullYear()}${p(d.getUTCMonth() + 1)}${p(d.getUTCDate())}-` +",
                      "        `${p(d.getUTCHours())}${p(d.getUTCMinutes())}${p(d.getUTCSeconds())}` +",
                      "        `${String(d.getUTCMilliseconds()).padStart(3, \"0\")}`;",
                      "    const eventTitle = `Event_${category}_API_${ts}`;",
                      "",
                      "    // Store current event state",
                      "    pm.collectionVariables.set(\"dd_eventTitle\", eventTitle);",
                      "    pm.collectionVariables.set(\"dd_eventDescription\", description);",
                      "    pm.collectionVariables.set(\"dd_eventCategory\", category);",
                      "    pm.collectionVariables.set(\"dd_eventVenue\", venue);",
                      "    pm.collectionVariables.set(\"dd_eventCity\", city);",
                      "    pm.collectionVariables.set(\"dd_eventPrice\", price);",
                      "    pm.collectionVariables.set(\"dd_eventTotalSeats\", totalSeats);",
                      "",
                      "    console.log(\"======================================\");",
                      "    console.log(\"Create Event Iteration:\", pm.info.iteration);",
                      "    console.log(\"Title:\", pm.collectionVariables.get(\"dd_eventTitle\"));",
                      "    console.log(\"Description:\", pm.collectionVariables.get(\"dd_eventDescription\"));",
                      "    console.log(\"Category:\", pm.collectionVariables.get(\"dd_eventCategory\"));",
                      "    console.log(\"Venue:\", pm.collectionVariables.get(\"dd_eventVenue\"));",
                      "    console.log(\"City:\", pm.collectionVariables.get(\"dd_eventCity\"));",
                      "    console.log(\"Price:\", pm.collectionVariables.get(\"dd_eventPrice\"));",
                      "    console.log(\"Total Seats:\", pm.collectionVariables.get(\"dd_eventTotalSeats\"));",
                      "    console.log(\"======================================\");",
                      "});",
                      "",
                      "// Generate future event date",
                      "pm.test(\"Pre-request: Generate future event date and set as collection variable\", () => {",
                      "    const d = new Date();",
                      "    d.setMonth(d.getMonth() + 3);",
                      "    const dateISO = d.toISOString();",
                      "",
                      "    pm.collectionVariables.set(\"dd_eventDate\", dateISO);",
                      "",
                      "    const eventDate = pm.collectionVariables.get(\"dd_eventDate\");",
                      "",
                      "    pm.test(`Pre-request: Generated event date: ${eventDate}`, () => {",
                      "        pm.expect(dateISO).to.be.a(\"string\").and.equal(eventDate);",
                      "    });",
                      "",
                      "    console.log(\"Generated event date:\", eventDate);",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n    \"title\": \"{{dd_eventTitle}}\",\r\n    \"description\": \"{{dd_eventDescription}}\",\r\n    \"category\": \"{{dd_eventCategory}}\",\r\n    \"venue\": \"{{dd_eventVenue}}\",\r\n    \"city\": \"{{dd_eventCity}}\",\r\n    \"eventDate\": \"{{dd_eventDate}}\",\r\n    \"price\": {{dd_eventPrice}},\r\n    \"totalSeats\": {{dd_eventTotalSeats}},\r\n    \"imageUrl\": \"https://example.com/banner.jpg\"\r\n}",
                  "options": {
