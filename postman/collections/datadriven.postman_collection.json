            {
              "name": "Update an event",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const jsonData = pm.response.json();",
                      "const data = jsonData.data;",
                      "const userID = pm.environment.get(\"userID\");",
                      "const eventID = pm.collectionVariables.get(\"dd_eventID\");",
                      "const eventUpdatedTitle = pm.collectionVariables.get(\"dd_eventUpdatedTitle\");",
                      "const eventUpdatedDescription = pm.collectionVariables.get(\"dd_eventUpdatedDescription\");",
                      "const eventCategory = pm.collectionVariables.get(\"dd_eventCategory\");",
                      "const eventVenue = pm.collectionVariables.get(\"dd_eventVenue\");",
                      "const eventCity = pm.collectionVariables.get(\"dd_eventCity\");",
                      "const eventDate = pm.collectionVariables.get(\"dd_eventDate\");",
                      "const eventNewPrice = Number(pm.collectionVariables.get(\"dd_eventNewPrice\"));",
                      "const eventNewTotalSeats = Number(pm.collectionVariables.get(\"dd_eventNewTotalSeats\"));",
                      "",
                      "pm.test(\"Response status code should be 200\", () => {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"success should be true\", () => {",
                      "    pm.expect(jsonData.success).to.exist.and.to.equal(true);",
                      "});",
                      "",
                      "pm.test(\"(BUG-001) Validate event data properties\", () => {",
                      "    pm.expect(data.id).to.equal(eventID);",
                      "    pm.expect(data.title).to.equal(eventUpdatedTitle);",
                      "    pm.expect(data.description).to.equal(eventUpdatedDescription);",
                      "    pm.expect(data.category).to.equal(eventCategory);",
                      "    pm.expect(data.venue).to.equal(eventVenue);",
                      "    pm.expect(data.city).to.equal(eventCity);",
                      "    pm.expect(data.eventDate).to.equal(eventDate);",
                      "    pm.expect(Number(data.price)).to.equal(eventNewPrice);",
                      "    pm.expect(data.totalSeats).to.equal(eventNewTotalSeats);",
                      "",
                      "    // BUG-001: When the totalSeats is updated, availableSeats is not recalculated accordingly.",
                      "    pm.expect(data.availableSeats).to.equal(eventNewTotalSeats);",
                      "",
                      "    pm.expect(data.imageUrl).to.equal(\"https://example.com/banner.jpg\");",
                      "    pm.expect(data.isStatic).to.equal(false);",
                      "    pm.expect(data.userId).to.equal(Number(userID));",
                      "    pm.expect(data.createdAt).to.be.a(\"string\").and.not.empty;",
                      "    pm.expect(data.updatedAt).to.be.a(\"string\").and.not.empty;",
                      "});",
                      "",
                      "pm.test(\"message should be 'Event updated successfully'\", () => {",
                      "    pm.expect(jsonData.message).to.exist.and.to.equal(\"Event updated successfully\");",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const updatedDescription = pm.iterationData.get(\"updatedDescription\");",
                      "const rawNewPrice = pm.iterationData.get(\"newPrice\");",
                      "const rawNewTotalSeats = pm.iterationData.get(\"newTotalSeats\");",
                      "",
                      "const eventNewPrice = Number(rawNewPrice);",
                      "const eventNewTotalSeats = Number(rawNewTotalSeats);",
                      "",
                      "const eventTitle = pm.collectionVariables.get(\"dd_eventTitle\");",
                      "const category = pm.collectionVariables.get(\"dd_eventCategory\");",
                      "",
                      "// Validate update data",
                      "pm.test(\"Pre-request: Validate eventData.csv data\", () => {",
                      "    // Description",
                      "    pm.expect(updatedDescription, \"updatedDescription\").to.be.a(\"string\").and.not.empty;",
                      "",
                      "    // Price",
                      "    pm.expect(rawNewPrice).to.not.be.undefined;",
                      "    pm.expect(rawNewPrice).to.not.equal(\"\");",
                      "    pm.expect(eventNewPrice).to.not.be.NaN;",
                      "    pm.expect(eventNewPrice).to.be.above(0);",
                      "",
                      "    // Total seats",
                      "    pm.expect(rawNewTotalSeats).to.not.be.undefined;",
                      "    pm.expect(rawNewTotalSeats).to.not.equal(\"\");",
                      "    pm.expect(eventNewTotalSeats).to.not.be.NaN;",
                      "    pm.expect(eventNewTotalSeats).to.be.above(0);",
                      "});",
                      "",
                      "// Generate updated event title",
                      "pm.test(\"Pre-request: Update event title and set as collection variable\", () => {",
                      "    const eventUpdatedTitle = eventTitle.split(\"API_\").join(\"Updated_API_\");",
                      "",
                      "    pm.test(`Pre-request: Updated event title: ${eventUpdatedTitle}`, () => {",
                      "        pm.expect(eventUpdatedTitle).to.not.equal(eventTitle);",
                      "    });",
                      "",
                      "    // Store updated values separately",
                      "    pm.collectionVariables.set(\"dd_eventUpdatedTitle\", eventUpdatedTitle);",
                      "    pm.collectionVariables.set(\"dd_eventUpdatedDescription\", updatedDescription);",
                      "    pm.collectionVariables.set(\"dd_eventNewPrice\", eventNewPrice);",
                      "    pm.collectionVariables.set(\"dd_eventNewTotalSeats\", eventNewTotalSeats);",
                      "});",
                      "",
                      "console.log(\"======================================\");",
                      "console.log(\"UPDATE EVENT\");",
