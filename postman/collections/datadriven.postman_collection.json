      "name": "Admin Login",
      "item": [
        {
          "name": "Login with existing credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();\r",
                  "const userName = pm.environment.get(\"userName\");\r",
                  "const userID = pm.environment.get(\"userID\");\r",
                  "\r",
                  "pm.test(\"Response status code should be 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"success should be true\", () => {\r",
                  "    pm.expect(jsonData.success).to.exist.and.to.equal(true);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has token property and not empty\", () => {\r",
                  "    pm.expect(jsonData).to.have.property(\"token\");\r",
                  "    pm.expect(jsonData.token).to.be.a(\"string\");\r",
                  "    pm.expect(jsonData.token).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Extract token and set environment variable\", () => {\r",
                  "    pm.environment.set(\"authToken\", jsonData.token);\r",
                  "    pm.expect(pm.environment.get(\"authToken\")).to.equal(jsonData.token);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains login user id and email\", () => {\r",
                  "    pm.expect(jsonData.user).to.exist;\r",
                  "    pm.expect(jsonData.user.id).to.equal(Number(userID));\r",
                  "    pm.expect(jsonData.user.email).to.equal(userName);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
